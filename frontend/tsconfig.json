{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "skipLibCheck": true,
    "strict": true, "noEmit": true, "jsx": "react-jsx", "allowImportingTsExtensions": true,
    "isolatedModules": true, "moduleDetection": "force", "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts"]
}
